# Editor defaults for every contributor (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Match the 2-space style already used across the repo's YAML/TOML/JSON
[*.{yml,yaml,json,toml}]
indent_size = 2
